{
  "name": "web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host",
    "test:map": "node --test scripts/map-location.test.mjs scripts/map-navigation.test.mjs",
    "test:risk": "node --test scripts/risk-analysis.test.mjs",
    "test:cost": "node --test scripts/cost-analysis.test.mjs",
    "test:order-margin": "node --experimental-strip-types --test scripts/order-margin-analysis.test.mjs",
    "test:traffic": "node --experimental-strip-types --test scripts/traffic-analysis.test.mjs",
    "test:management": "node --test scripts/management-pages.test.mjs",
    "data:sync-traffic": "node ../scripts/sync-traffic-data.mjs",
    "data:sync-cost": "node ../scripts/sync-cost-data.mjs",
    "data:sync-risk": "node ../scripts/sync-risk-data.mjs",
    "data:sync-order-margin": "node ../scripts/sync-order-margin.mjs",
    "data:sync-source1": "node ../scripts/sync-source1.mjs",
    "data:sync-ops": "node ../scripts/sync-ops-excel.mjs",
    "data:sync-pack": "node ../scripts/sync-ops-pack.mjs"
  },
  "dependencies": {
    "@vueuse/core": "^14.4.0",
    "echarts": "^6.1.0",
    "echarts-gl": "^2.1.0",
    "leaflet": "^1.9.4",
    "pinia": "^4.0.3",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "sass": "^1.103.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11"
  }
}
